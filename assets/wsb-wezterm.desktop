[Desktop Entry]
Name=wsb-wezterm
Comment=A terminal emulator and multiplexer, a fork of WezTerm
Keywords=shell;prompt;command;commandline;cmd;
Icon=com.bahramj.wsb-wezterm
StartupWMClass=com.bahramj.wsb-wezterm
TryExec=wsb-wezterm
Exec=wsb-wezterm start --cwd .
Type=Application
Categories=System;TerminalEmulator;Utility;
Terminal=false
